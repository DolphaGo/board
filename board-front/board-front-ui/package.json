{
  "name": "board-front-ui",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "format": "prettier --write \"src/**/*.{vue,ts}\" && eslint src --fix",
    "build": "pnpm typecheck && vite build",
    "serve": "vite preview",
    "prepare": "cd ../.. && husky board-front/board-front-ui/.husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@stomp/stompjs": "7.3.0",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "esbuild": "0.28.2",
    "file-saver": "2.0.5",
    "marked": "18.0.14",
    "sockjs-client": "1.6.1",
    "streamsaver": "2.0.6",
    "v-calendar": "3.1.2",
    "v-pagination-3": "0.1.7",
    "vue": "3.5.43",
    "vue-intl": "8.1.2",
    "vue-loaders": "4.1.4",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@formatjs/cli": "6.16.32",
    "@types/file-saver": "2.0.7",
    "@types/node": "26.6.4",
    "@types/sockjs-client": "1.5.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/test-utils": "2.5.1",
    "cypress": "16.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "rollup-plugin-analyzer": "4.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-clipboard3": "2.0.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "26.10.0",
    "pnpm": "12.8.1"
  }
}
